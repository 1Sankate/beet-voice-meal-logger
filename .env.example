# Copy to .env at the repo root. All three processes read this one file.

# --- LiveKit (free plan, no card: https://cloud.livekit.io) ---------------
# Project settings -> Keys. The same three values are used by the token
# endpoint in the API and by the Python agent.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- API ------------------------------------------------------------------
PORT=4000
# Where the agent finds the API. Leave as-is for local runs.
BEET_API_URL=http://localhost:4000

# --- Database -------------------------------------------------------------
# Leave MONGODB_URI empty to run an embedded mongod with an on-disk data
# directory (server/.data/mongo) — nothing to install, and logs survive a
# restart. Set it to use Atlas or your own mongod instead.
# MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=beet

# --- Models (optional) ----------------------------------------------------
# Served through LiveKit Inference, so the LiveKit key above is the only
# credential needed. Override to use different models.
# BEET_STT_MODEL=deepgram/nova-3
# BEET_LLM_MODEL=openai/gpt-4.1-mini
# BEET_TTS_MODEL=cartesia/sonic-3
